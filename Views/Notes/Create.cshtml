@model AspNetMvcDemo.Models.NoteCreateViewModel

@{
    ViewData["Title"] = "Tạo ghi chú";
}

<div class="notes-form-page">
    <div class="notes-form-card">
        <div class="notes-form-header">
            <h1>Tạo ghi chú</h1>
        </div>

        <form asp-controller="Notes"
              asp-action="Create"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="auth-summary"></div>

            <div class="auth-field">
                <label asp-for="Title"></label>
                <input asp-for="Title"
                       class="form-control"
                       maxlength="200"
                       autofocus />
                <span asp-validation-for="Title"
                      class="auth-validation"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Content"></label>
                <textarea asp-for="Content"
                          class="form-control note-content-input"
                          rows="8"></textarea>
                <span asp-validation-for="Content"
                      class="auth-validation"></span>
            </div>

            <div class="notes-form-actions">
                <a asp-controller="Notes"
                   asp-action="Index"
                   class="notes-cancel-button">
                    Hủy
                </a>

                <button type="submit"
                        class="auth-button">
                    Lưu ghi chú
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}