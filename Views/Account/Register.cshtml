@model AspNetMvcDemo.Models.RegisterViewModel

<div class="auth-page">
    <div class="auth-card">
        <img src="~/images/logo20HOU20new-bold.png"
                 alt="Logo trường"
                 class="auth-logo" />
        <h1 class="auth-title">Tạo tài khoản</h1>

        <form asp-controller="Account"
              asp-action="Register"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="auth-summary"></div>

            <div class="auth-field">
                <label asp-for="Username"></label>
                <input asp-for="Username" autocomplete="username" />
                <span asp-validation-for="Username"
                      class="auth-validation"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="email" />
                <span asp-validation-for="Email"
                      class="auth-validation"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="new-password" />
                <span asp-validation-for="Password"
                      class="auth-validation"></span>
            </div>

            <div class="auth-field">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"
                      class="auth-validation"></span>
            </div>

            <button type="submit" class="auth-button">
                Đăng ký
            </button>
        </form>

        <a asp-controller="Account"
           asp-action="Login"
           class="auth-link">
            Đã có tài khoản? Đăng nhập
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}