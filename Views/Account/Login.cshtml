@model AspNetMvcDemo.Models.LoginViewModel

<div class="auth-page">
    <div class="auth-card">
        <img src="~/images/logo20HOU20new-bold.png"
                 alt="Logo trường"
                 class="auth-logo" />

        <h1 class="auth-title">Đăng nhập</h1>

        <form asp-controller="Account"
              asp-action="Login"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="auth-summary"></div>

            <div class="auth-field">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="email" />
                <span asp-validation-for="Email"
                      class="auth-validation"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="current-password" />
                <span asp-validation-for="Password"
                      class="auth-validation"></span>
            </div>


            <button type="submit" class="auth-button">
                Đăng nhập
            </button>
        </form>

        <a asp-controller="Account"
           asp-action="Register"
           class="auth-link">
            Chưa có tài khoản? Đăng ký
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}